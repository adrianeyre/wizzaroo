    {
      "skillId": "geography.time-zones",
      "title": "Time Zone Trekker",
      "skillName": "Time zones, day and night",
      "strand": "locational-knowledge",
      "scene": "globe-spinner",
      "instruction": "Watch where the Sun lights the globe, then work out the time around the world.",
      "questions": [
        {
          "ask": "It is noon GMT. Tokyo is 9 hours ahead. What time is it there?",
          "show": {
            "pin": {
              "latitude": 35.68,
              "longitude": 139.69
            },
            "sunLongitude": 0
          },
          "answer": "9 pm",
          "wrongAnswers": ["3 am", "9 am", "3 pm"]
        },
        {
          "ask": "It is noon GMT. Honolulu is 10 hours behind. What time is it there?",
          "show": {
            "pin": {
              "latitude": 21.31,
              "longitude": -157.86
            },
            "sunLongitude": 0
          },
          "answer": "2 am",
          "wrongAnswers": ["10 pm", "10 am", "2 pm"]
        },
        {
          "ask": "It is noon in London in January. Dubai is GMT+4. What time is it there?",
          "show": {
            "pin": {
              "latitude": 25.2,
              "longitude": 55.27
            },
            "sunLongitude": 0
          },
          "answer": "4 pm",
          "wrongAnswers": ["8 am", "4 am", "2 pm"]
        },
        {
          "ask": "It is 9 am in London in January. Bangkok is 7 hours ahead. Time there?",
          "show": {
            "pin": {
              "latitude": 13.76,
              "longitude": 100.5
            },
            "sunLongitude": 45
          },
          "answer": "4 pm",
          "wrongAnswers": ["2 am", "4 am", "2 pm"]
        },
        {
          "ask": "The Sun is right over this line. What time is it at Greenwich?",
          "show": {
            "highlight": "prime-meridian",
            "sunLongitude": 0
          },
          "answer": "12 noon",
          "wrongAnswers": ["Midnight", "6 am", "6 pm"]
        },
        {
          "ask": "The Sun is over the far side of the Earth. What time is it at Greenwich?",
          "show": {
            "highlight": "prime-meridian",
            "sunLongitude": 180
          },
          "answer": "Midnight",
          "wrongAnswers": ["12 noon", "6 am", "6 pm"]
        },
        {
          "ask": "How many degrees of longitude does the Earth turn each hour?",
          "show": {
            "highlight": "equator",
            "sunLongitude": 0
          },
          "answer": "15°",
          "wrongAnswers": ["1°", "24°", "60°"]
        },
        {
          "ask": "It is noon GMT in January. New York is GMT−5. What time is it there?",
          "show": {
            "pin": {
              "latitude": 40.71,
              "longitude": -74.01
            },
            "sunLongitude": 0
          },
          "answer": "7 am",
          "wrongAnswers": ["5 pm", "5 am", "7 pm"]
        },
        {
          "ask": "It is noon GMT. Beijing is 8 hours ahead. What time is it there?",
          "show": {
            "pin": {
              "latitude": 39.9,
              "longitude": 116.41
            },
            "sunLongitude": 0
          },
          "answer": "8 pm",
          "wrongAnswers": ["4 am", "8 am", "4 pm"]
        },
        {
          "ask": "Reykjavik uses GMT all year. In January, London says 15:00. What does Reykjavik say?",
          "show": {
            "pin": {
              "latitude": 64.15,
              "longitude": -21.94
            },
            "sunLongitude": -45
          },
          "answer": "3 pm",
          "wrongAnswers": ["2 pm", "4 pm", "3 am"]
        },
        {
          "ask": "It is noon GMT. Lagos is 1 hour ahead. What time is it there?",
          "show": {
            "pin": {
              "latitude": 6.52,
              "longitude": 3.38
            },
            "sunLongitude": 0
          },
          "answer": "1 pm",
          "wrongAnswers": ["11 am", "1 am", "12 noon"]
        },
        {
          "ask": "It is 6 pm GMT. Nairobi is 3 hours ahead. What time is it there?",
          "show": {
            "pin": {
              "latitude": -1.29,
              "longitude": 36.82
            },
            "sunLongitude": -90
          },
          "answer": "9 pm",
          "wrongAnswers": ["3 pm", "9 am", "3 am"]
        },
        {
          "ask": "Why is it night over this ocean right now?",
          "show": {
            "highlight": "pacific-ocean",
            "sunLongitude": 0
          },
          "answer": "Facing away from the Sun",
          "wrongAnswers": [
            "Covered by thick cloud",
            "The Moon blocks the Sun",
            "It is winter there"
          ]
        }
      ]
