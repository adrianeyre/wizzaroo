{
  "name": "wizzaroo",
  "version": "0.0.0-development",
  "description": "A 3D learning game for primary-school children that teaches the UK National Curriculum (Years 1-6), built as an offline-first PWA for one family.",
  "license": "ISC",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "lint:fix": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js . --fix --max-warnings 0",
    "prettier": "prettier . --check",
    "prettier:write": "prettier . --write",
    "format": "pnpm run lint:fix && pnpm run prettier:write",
    "test": "vitest run --coverage --project node --project dom",
    "test:watch": "vitest --project node --project dom",
    "test:sweeps": "vitest run --project sweeps",
    "start": "node --enable-source-maps dist/src/server/index.js",
    "run:local": "tsx --env-file-if-exists=.env src/server/development.ts",
    "dev": "vite build && pnpm run run:local",
    "migrate": "tsx --env-file-if-exists=.env src/server/development.ts migrate",
    "download:voices": "tsx --env-file-if-exists=.env src/server/development.ts download-voices",
    "seed:owner": "tsx --env-file-if-exists=.env src/server/development.ts seed-owner",
    "pen-test:up": "tsx src/server/pen-test-deployment/run-pen-test-deployment.ts up",
    "pen-test:seed": "tsx src/server/pen-test-deployment/run-pen-test-deployment.ts seed",
    "pen-test:credentials": "tsx src/server/pen-test-credentials/run-pen-test-credentials.ts package",
    "pen-test:sign-in": "tsx src/server/pen-test-credentials/run-pen-test-credentials.ts sign-in",
    "pen-test:down": "tsx src/server/pen-test-deployment/run-pen-test-deployment.ts down",
    "generate:voice-over": "tsx src/client/voice-over/generate-voice-over.ts",
    "prepare:phonemes": "tsx src/client/voice-over/prepare-phonemes.ts",
    "generate:attraction-sites": "tsx src/client/islands/generate-attraction-sites.ts && tsx src/client/islands/generate-curiosity-sites.ts && tsx src/client/islands/generate-quest-sites.ts && tsx src/client/islands/generate-new-land-attraction-sites.ts && prettier --write src/client/islands/island-attraction-sites.ts src/client/islands/island-curiosity-sites.ts src/client/islands/island-quest-sites.ts src/client/islands/island-new-land-attraction-sites.ts",
    "generate:tunnel-hills": "tsx src/client/islands/generate-tunnel-hills.ts && prettier --write src/client/islands/island-tunnel-hill-sites.ts",
    "generate:check-voice-over": "tsx src/client/checks/generate-check-voice-over.ts",
    "sandcastle": "tsx .sandcastle/main.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "@eslint/js": "^10.0.1",
    "@react-three/test-renderer": "^9.1.1",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "semantic-release": "^26.0.1",
    "testcontainers": "^12.2.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@adrianeyre/email-client": "^0.1.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@react-three/fiber": "^9.8.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "onnxruntime-web": "1.31.1",
    "pg": "^8.23.1",
    "phonemizer": "1.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "uqr": "0.1.3"
  }
}
