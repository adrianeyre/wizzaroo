# @adrianeyre/email-client, which sends Wizzaroo's emails through the email platform, comes from GitHub Packages.
# pnpm takes no token from a repository's .npmrc, so the token (read:packages) goes in your user-level ~/.npmrc:
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
@adrianeyre:registry=https://npm.pkg.github.com
