      "css": ".ds-btn-sheet{display:inline-flex;align-items:center;min-height:52px;padding:0 1.5rem;border:2px solid var(--colour-keyline,#22323d);border-radius:3px;background:var(--colour-card,#fcfdf8);color:var(--colour-foreground,#14212b);font-family:'Barlow Condensed','Arial Narrow',system-ui,sans-serif;font-size:1.3125rem;font-weight:700;letter-spacing:.01em;text-decoration:none;transition:background-color 150ms ease-out}.ds-btn-sheet:hover{background:var(--colour-muted,#eef4e4)}.ds-btn-sheet:focus-visible{outline:3px solid var(--colour-map-magenta,#b8166f);outline-offset:3px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "48px field, 2px outline, magenta focus ring.",
      "html": "<label class=\"ds-field\">Family name<input class=\"ds-input\" value=\"The Rivers\"></label>",
      "css": ".ds-field{display:grid;gap:.25rem;font-family:Andika,ui-rounded,system-ui,sans-serif;font-weight:700;color:var(--colour-foreground,#14212b)}.ds-input{min-height:48px;padding:0 .75rem;border:2px solid var(--colour-input-border,#5a7382);border-radius:3px;background:var(--colour-card,#fcfdf8);color:var(--colour-foreground,#14212b);font:inherit;font-weight:400;transition:border-color 150ms ease-out}.ds-input:hover{border-color:var(--colour-muted-foreground,#3b505d)}.ds-input:focus-visible{border-color:var(--colour-primary,#1b5ea6);outline:3px solid var(--colour-map-magenta,#b8166f);outline-offset:1px}"
    },
    {
      "name": "Region Chip",
      "kind": "chip",
      "refersTo": "region-chip",
      "description": "The map's own place label over the 3D world; pressed takes the theme ink.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"false\">Number Bay <span class=\"ds-chip-tag\">Maths</span></button> <button class=\"ds-chip\" aria-pressed=\"true\">Letter Cove <span class=\"ds-chip-tag\">Phonics</span></button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:.5rem;min-height:44px;padding:0 .75rem 0 .5rem;border:1px solid var(--colour-keyline,#22323d);border-radius:3px;background:var(--colour-card,#fcfdf8);color:var(--colour-foreground,#14212b);font-family:'Barlow Condensed','Arial Narrow',system-ui,sans-serif;font-size:1.0625rem;font-weight:700;letter-spacing:.01em;box-shadow:0 1px 2px rgb(20 33 43 / .16);cursor:pointer;white-space:nowrap}.ds-chip-tag{padding:.0625rem .5rem;border-radius:3px;background:var(--colour-primary,#1b5ea6);color:var(--colour-on-primary,#fff);font-size:.75rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.ds-chip:hover{border-color:var(--colour-primary,#1b5ea6)}.ds-chip:active{transform:scale(.96);box-shadow:none}.ds-chip[aria-pressed=true]{border-color:var(--colour-primary,#1b5ea6);background:var(--colour-primary,#1b5ea6);color:var(--colour-on-primary,#fff)}.ds-chip[aria-pressed=true] .ds-chip-tag{background:var(--colour-on-primary,#fff);color:var(--colour-primary,#1b5ea6)}.ds-chip:focus-visible{outline:3px solid var(--colour-map-magenta,#b8166f);outline-offset:3px}"
    },
    {
      "name": "Land Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "A section printed as land on the sea, inside a 2px keyline.",
      "html": "<section class=\"ds-panel\"><h2>Your Family</h2><p>Two Children are exploring the Islands.</p></section>",
      "css": ".ds-panel{display:grid;gap:1rem;padding:1.5rem;border:2px solid var(--colour-keyline,#22323d);border-radius:3px;background:var(--colour-card,#fcfdf8);color:var(--colour-foreground,#14212b);font-family:Andika,ui-rounded,system-ui,sans-serif;font-size:1.0625rem;line-height:1.55}.ds-panel h2{margin:0;font-family:'Barlow Condensed','Arial Narrow',system-ui,sans-serif;font-size:1.625rem;font-weight:700;line-height:1.1}.ds-panel p{margin:0}"
    },
    {
      "name": "Cover Band",
      "kind": "nav",
      "refersTo": "cover-band",
      "description": "Site header: the sheet's orange cover with uppercase map lettering.",
      "html": "<header class=\"ds-cover\"><span class=\"ds-cover-title\">Wizzaroo</span><button class=\"ds-cover-menu\">Menu</button></header>",
      "css": ".ds-cover{display:flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border-bottom:2px solid var(--colour-keyline,#22323d);background:var(--colour-cover,#f27a1a);color:#1a1206}.ds-cover-title{margin-right:auto;font-family:'Barlow Condensed','Arial Narrow',system-ui,sans-serif;font-size:2.125rem;font-weight:800;letter-spacing:.08em;line-height:1;text-transform:uppercase}.ds-cover-menu{min-height:44px;padding:0 1rem;border:2px solid #1a1206;border-radius:3px;background:#fcfdf8;color:#14212b;font-family:Andika,ui-rounded,system-ui,sans-serif;font-weight:700;cursor:pointer}.ds-cover-menu:hover{background:#ffe7d1}.ds-cover-menu:focus-visible{outline:3px solid #1a1206;outline-offset:3px}"
    },
    {
      "name": "Sidebar Link",
      "kind": "nav",
      "refersTo": "sidebar-link",
      "description": "Parent sidebar: the current section is the square you are in, inked in the theme colour.",
      "html": "<nav class=\"ds-side\"><a class=\"ds-side-link\" href=\"#\" aria-current=\"page\">Dashboard</a><a class=\"ds-side-link\" href=\"#\">Progress</a></nav>",
      "css": ".ds-side{display:grid;gap:.25rem;width:17rem;padding:1rem .75rem;border-right:2px solid var(--colour-keyline,#22323d);background:var(--colour-card,#fcfdf8)}.ds-side-link{display:flex;align-items:center;min-height:44px;padding:0 .75rem;border-radius:4px;color:var(--colour-foreground,#14212b);font-family:Andika,ui-rounded,system-ui,sans-serif;font-weight:700;text-decoration:none;transition:background-color 150ms ease-out}.ds-side-link:hover{background:var(--colour-muted,#eef4e4)}.ds-side-link[aria-current=page]{background:var(--colour-primary,#1b5ea6);color:var(--colour-on-primary,#fff)}.ds-side-link:focus-visible{outline:3px solid var(--colour-map-magenta,#b8166f);outline-offset:-3px}"
    },
    {
      "name": "Map Sheet",
      "kind": "custom",
      "description": "Signature frame: grid references in the margin, one lit in magenta, and an uppercase sheet title.",
      "html": "<div class=\"ds-sheet\"><div class=\"ds-sheet-top\"><span>A</span><span class=\"lit\">B</span><span>C</span><span>D</span></div><div class=\"ds-sheet-face\"></div><div class=\"ds-sheet-title\">Explorer map · Years 1 to 6</div></div>",
      "css": ".ds-sheet{display:grid;gap:.25rem;padding:.5rem;border:2px solid var(--colour-keyline,#22323d);border-radius:3px;background:var(--colour-card,#fcfdf8);width:22rem}.ds-sheet-top{display:grid;grid-template-columns:repeat(4,1fr);font-family:'Barlow Condensed','Arial Narrow',system-ui,sans-serif;font-size:.875rem;font-weight:700;letter-spacing:.08em;color:var(--colour-muted-foreground,#3b505d);text-align:center}.ds-sheet-top .lit{background:var(--colour-map-magenta,#b8166f);color:#fff}.ds-sheet-face{height:8rem;border:2px solid var(--colour-keyline,#22323d);background-image:linear-gradient(rgb(29 95 168 / .11) 1px,transparent 1px),linear-gradient(90deg,rgb(29 95 168 / .11) 1px,transparent 1px);background-size:25% 50%}.ds-sheet-title{padding-top:.25rem;font-family:'Barlow Condensed','Arial Narrow',system-ui,sans-serif;font-size:.9375rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;text-align:center;color:var(--colour-muted-foreground,#3b505d)}"
    },
    {
      "name": "Square Meter",
      "kind": "custom",
      "description": "Progress marked off square by square: the meter is masked into squares.",
      "html": "<div class=\"ds-meter\"><span style=\"width:70%\"></span></div>",
      "css": ".ds-meter{width:12rem;height:.625rem;background:color-mix(in oklab,#1b5ea6 8%,#e6eee8);-webkit-mask:repeating-linear-gradient(90deg,#000 0 .625rem,transparent .625rem .75rem);mask:repeating-linear-gradient(90deg,#000 0 .625rem,transparent .625rem .75rem)}.ds-meter span{display:block;height:100%;background:var(--colour-primary,#1b5ea6)}"
    }
  ],
  "narrative": {
    "northStar": "The Island Explorer Map",
    "overview": "**Creative North Star: \"The Island Explorer Map\"**\n\nEvery HTML screen is a sheet of the explorer's map: the home page, signing in, the Parent, Teacher and Admin pages, Settings, and the menus, panels and bars over the game. The page is the sea, ruled into 4rem grid squares. Panels are land, printed inside a 2px ink keyline with small square corners. The header is the sheet's orange cover band. Map lettering and headings are condensed; body text is set in a primer face for children still learning to read.\n\nThe world refuses the ed-tech default of dark navy, gradient text and rows of rounded cards. Depth comes from the map's printed layers (sea, land, keyline), not from soft shadows, glass or gradients. Colour is functional, as on a real map: orange is the cover and the main way in, magenta marks routes, labels and focus, the user's theme colour inks links, buttons and chosen states.\n\nThe system ships in light and dark (\"sea-blue paper\" by day, \"night chart\" in navy-teal by night) and in six theme printings. The product's default colour mode is Dark; that is a product setting and this system leaves it unchanged. The 3D world and the in-Game boards' own art are out of scope: they keep their own look, and Baloo 2 and Nunito remain bundled only for canvas lettering in the 3D world.",
    "keyCharacteristics": [
      "Sea ground ruled into map squares; land panels inside 2px keylines.",
      "Orange cover band for the header, the closing call and the primary home action.",
      "Magenta for map labels, routes, lit grid references and every focus ring.",
      "Barlow Condensed for map lettering and headings, Andika for reading.",
      "Square corners (3px), never pills; true circles only where a symbol is round.",
      "Flat print: no ambient shadows on panels, cards or buttons."
    ],
    "rules": [
      {
        "name": "The Six Printings Rule",
        "body": "The six themes are six printings of one map. A theme changes only the theme ink and a few percent of tint in sea, land, muted and border; cover orange, magenta and keyline ink never change with the theme.",
        "section": "colors"
      },
      {
        "name": "The Chosen-Is-Theme, Focus-Is-Magenta Rule",
        "body": "Chosen, current and pressed states take the user's theme colour. Focus is always a 3px magenta outline. Never swap them.",
        "section": "colors"
      },
      {
        "name": "The Orange Cover Rule",
        "body": "Orange is the cover: the header band, the main way in, and the closing call. Text on orange is On-Cover Ink (#1a1206), never white.",
        "section": "colors"
      },
      {
        "name": "The Sentence-Case Rule",
        "body": "Headings are sentence case, for early readers. Uppercase is reserved for map lettering: the cover-band title, the sheet title, Island Years, map-key Region names and Region chip subject tags.",
        "section": "typography"
      },
      {
        "name": "The Reading-Face-In-Buttons Rule",
        "body": "Generic buttons and small text inside controls stay in Andika (700). Condensed lettering goes only on play-bar tabs, form submits, home actions and Region chips, the controls that name places and actions in big type.",
        "section": "typography"
      },
      {
        "name": "The Printed-Layer Rule",
        "body": "A panel lifts off the sea by being land inside a keyline, not by a shadow. If a new surface needs separation, give it land paper and a 2px keyline.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put every new panel on land paper inside a 2px keyline with a 3px corner.",
      "Do ink chosen, current and pressed states in the user's theme colour, and focus in a 3px magenta outline.",
      "Do set headings in sentence case Barlow Condensed, and keep uppercase for map lettering.",
      "Do keep reading text and generic button labels in Andika.",
      "Do draw progress as squares (0.625rem squares, 0.125rem gaps) and routes as dashed magenta.",
      "Do give every theme the same cover orange, magenta and keyline ink; only the theme ink and tints change."
    ],
    "donts": [
      "Don't use dark navy as a fixed brand ground, gradient text, or rows of rounded cards.",
      "Don't give panels, cards or buttons soft ambient shadows; separation is land on sea inside a keyline.",
      "Don't put white text on cover orange; use on-cover ink.",
      "Don't use full pill radii on controls; the round token is 3px.",
      "Don't use Baloo 2 or Nunito in HTML; they are for canvas lettering in the 3D world only.",
      "Don't restyle the 3D world or the in-Game boards' own art with these tokens."
    ]
  }
}
